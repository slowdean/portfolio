 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 📊 Sales Performance Analysis\n",
    "\n",
    "## Objective\n",
    "Analyze sales data to identify top-performing products and regions."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Import libraries\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from datetime import datetime\n",
    "\n",
    "# Set display options\n",
    "pd.set_option('display.max_columns', None)\n",
    "plt.style.use('seaborn-v0_8-whitegrid')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load the dataset\n",
    "df = pd.read_csv('data/sales_data.csv')\n",
    "\n",
    "# Basic info\n",
    "print(\"Dataset Shape:\", df.shape)\n",
    "print(\"\\nColumn Types:\")\n",
    "print(df.dtypes)\n",
    "print(\"\\nFirst 5 rows:\")\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Data Cleaning"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Convert date column\n",
    "df['date'] = pd.to_datetime(df['date'])\n",
    "\n",
    "# Check for missing values\n",
    "print(\"Missing Values:\")\n",
    "print(df.isnull().sum())\n",
    "\n",
    "# Basic statistics\n",
    "print(\"\\nBasic Statistics:\")\n",
    "df.describe()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Key Metrics Calculation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Total Revenue\n",
    "total_revenue = df['total_amount'].sum()\n",
    "print(f\"💰 Total Revenue: €{total_revenue:,.2f}\")\n",
    "\n",
    "# Total Orders\n",
    "total_orders = df['transaction_id'].nunique()\n",
    "print(f\"📦 Total Orders: {total_orders}\")\n",
    "\n",
    "# Average Order Value\n",
    "aov = total_revenue / total_orders\n",
    "print(f\"📊 Average Order Value: €{aov:.2f}\")\n",
    "\n",
    "# Total Units Sold\n",
    "total_units = df['quantity'].sum()\n",
    "print(f\"🔢 Total Units Sold: {total_units}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Revenue by Category"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Revenue by category\n",
    "category_revenue = df.groupby('category')['total_amount'].sum().sort_values(ascending=False)\n",
    "print(\"Revenue by Category:\")\n",
    "print(category_revenue)\n",
    "\n",
    "# Visualize\n",
    "fig, ax = plt.subplots(figsize=(10, 5))\n",
    "category_revenue.plot(kind='bar', color=['#2ecc71', '#3498db', '#9b59b6'], ax=ax)\n",
    "ax.set_title('Revenue by Category', fontsize=14, fontweight='bold')\n",
    "ax.set_xlabel('Category')\n",
    "ax.set_ylabel('Revenue (€)')\n",
    "plt.xticks(rotation=45)\n",
    "plt.tight_layout()\n",
    "plt.savefig('dashboard/revenue_by_category.png', dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Revenue by Region"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Revenue by region\n",
    "region_revenue = df.groupby('region')['total_amount'].sum().sort_values(ascending=False)\n",
    "print(\"Revenue by Region:\")\n",
    "print(region_revenue)\n",
    "\n",
    "# Visualize\n",
    "fig, ax = plt.subplots(figsize=(10, 5))\n",
    "region_revenue.plot(kind='bar', color=['#e74c3c', '#f39c12', '#1abc9c', '#3498db'], ax=ax)\n",
    "ax.set_title('Revenue by Region', fontsize=14, fontweight='bold')\n",
    "ax.set_xlabel('Region')\n",
    "ax.set_ylabel('Revenue (€)')\n",
    "plt.xticks(rotation=45)\n",
    "plt.tight_layout()\n",
    "plt.savefig('dashboard/revenue_by_region.png', dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Top Products"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Top 10 products by revenue\n",
    "top_products = df.groupby('product_name')['total_amount'].sum().sort_values(ascending=False).head(10)\n",
    "print(\"Top 10 Products by Revenue:\")\n",
    "print(top_products)\n",
    "\n",
    "# Visualize\n",
    "fig, ax = plt.subplots(figsize=(12, 6))\n",
    "top_products.plot(kind='barh', color='#3498db', ax=ax)\n",
    "ax.set_title('Top 10 Products by Revenue', fontsize=14, fontweight='bold')\n",
    "ax.set_xlabel('Revenue (€)')\n",
    "ax.invert_yaxis()\n",
    "plt.tight_layout()\n",
    "plt.savefig('dashboard/top_products.png', dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Monthly Trend"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Monthly revenue\n",
    "df['month'] = df['date'].dt.to_period('M')\n",
    "monthly_revenue = df.groupby('month')['total_amount'].sum()\n",
    "print(\"Monthly Revenue:\")\n",
    "print(monthly_revenue)\n",
    "\n",
    "# Visualize\n",
    "fig, ax = plt.subplots(figsize=(10, 5))\n",
    "monthly_revenue.plot(kind='line', marker='o', linewidth=2, color='#2ecc71', ax=ax)\n",
    "ax.set_title('Monthly Revenue Trend', fontsize=14, fontweight='bold')\n",
    "ax.set_xlabel('Month')\n",
    "ax.set_ylabel('Revenue (€)')\n",
    "plt.tight_layout()\n",
    "plt.savefig('dashboard/monthly_trend.png', dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Key Insights & Recommendations"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"\"\"\n",
    "## 🔑 Key Findings\n",
    "\n",
    "### 1. Top Category\n",
    f\"Electronics dominates with €{category_revenue['Electronics']:,.2f} in revenue.\"\n",
    "\n",
    "### 2. Top Region\n",
    f\"Madrid leads with €{region_revenue['Madrid']:,.2f} in revenue.\"\n",
    "\n",
    "### 3. Best-Selling Product\n",
    f\"Laptop Pro 15\\\" generates the most revenue.\"\n",
    "\n",
    "### 4. Average Order Value\n",
    f\"AOV is €{aov:.2f}\"\n",
    "\n",
    "---\n",
    "\n",
    "## 💡 Recommendations\n",
    "\n",
    "1. **Focus on Electronics** - It's the top revenue driver\n",
    "2. **Expand in Valencia** - Growing region with potential\n",
    "3. **Bundle Products** - Pair Laptop Pro with accessories to increase AOV\n",
    "4. **Analyze Madrid further** - Understand why it's performing best\n",
    "\"\"\")"
   ]
  }
 ],
