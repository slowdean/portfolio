{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Customer Segmentation Analysis\n",
    "\n",
    "## RFM Analysis + K-means Clustering"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Import libraries\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.cluster import KMeans\n",
    "from datetime import datetime\n",
    "\n",
    "plt.style.use('seaborn-v0_8-whitegrid')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Load Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df = pd.read_csv('data/customer_transactions.csv')\n",
    "df['purchase_date'] = pd.to_datetime(df['purchase_date'])\n",
    "\n",
    "print(\"Dataset Shape:\", df.shape)\n",
    "print(\"\\nFirst 5 rows:\")\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. RFM Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Set analysis date (one day after last purchase)\n",
    "analysis_date = df['purchase_date'].max() + pd.Timedelta(days=1)\n",
    "print(f\"Analysis Date: {analysis_date}\")\n",
    "\n",
    "# Calculate RFM metrics\n",
    "rfm = df.groupby('customer_id').agg({\n",
    "    'purchase_date': lambda x: (analysis_date - x.max()).days,  # Recency\n",
    "    'transaction_id': 'count',  # Frequency\n",
    "    'amount': 'sum'  # Monetary\n",
    "}).reset_index()\n",
    "\n",
    "rfm.columns = ['customer_id', 'recency', 'frequency', 'monetary']\n",
    "\n",
    "print(\"\\nRFM Table:\")\n",
    "rfm.head(10)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. RFM Scoring"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create RFM scores (1-5, where 5 is best)\n",
    "rfm['R_score'] = pd.qcut(rfm['recency'], q=5, labels=[5, 4, 3, 2, 1], duplicates='drop')\n",
    "rfm['F_score'] = pd.qcut(rfm['frequency'].rank(method='first'), q=5, labels=[1, 2, 3, 4, 5])\n",
    "rfm['M_score'] = pd.qcut(rfm['monetary'].rank(method='first'), q=5, labels=[1, 2, 3, 4, 5])\n",
    "\n",
    "# Convert to numeric\n",
    "rfm['R_score'] = rfm['R_score'].astype(int)\n",
    "rfm['F_score'] = rfm['F_score'].astype(int)\n",
    "rfm['M_score'] = rfm['M_score'].astype(int)\n",
    "\n",
    "# RFM Score\n",
    "rfm['RFM_score'] = rfm['R_score'] + rfm['F_score'] + rfm['M_score']\n",
    "\n",
    "print(\"RFM Scores:\")\n",
    "rfm.head(10)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Customer Segments"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Define segments based on RFM score\n",
    "def segment_customer(score):\n",
    "    if score >= 13:\n",
    "        return 'Champions'\n",
    "    elif score >= 10:\n",
    "        return 'Loyal Customers'\n",
    "    elif score >= 7:\n",
    "        return 'Potential Loyalists'\n",
    "    elif score >= 5:\n",
    "        return 'At Risk'\n",
    "    else:\n",
    "        return 'Lost'\n",
    "\n",
    "rfm['segment'] = rfm['RFM_score'].apply(segment_customer)\n",
    "\n",
    "# Segment distribution\n",
    "segment_counts = rfm['segment'].value_counts()\n",
    "print(\"Segment Distribution:\")\n",
    "print(segment_counts)\n",
    "\n",
    "# Visualize\n",
    "fig, ax = plt.subplots(figsize=(10, 5))\n",
    "segment_counts.plot(kind='bar', color=['#2ecc71', '#3498db', '#f39c12', '#e74c3c', '#9b59b6'], ax=ax)\n",
    "ax.set_title('Customer Segments Distribution', fontsize=14, fontweight='bold')\n",
    "ax.set_xlabel('Segment')\n",
    "ax.set_ylabel('Number of Customers')\n",
    "plt.xticks(rotation=45)\n",
    "plt.tight_layout()\n",
    "plt.savefig('segment_distribution.png', dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. K-means Clustering"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Prepare data for clustering\n",
    "rfm_features = rfm[['recency', 'frequency', 'monetary']]\n",
    "\n",
    "# Scale features\n",
    "scaler = StandardScaler()\n",
    "rfm_scaled = scaler.fit_transform(rfm_features)\n",
    "\n",
    "# Find optimal k using Elbow method\n",
    "inertias = []\n",
    "K = range(2, 8)\n",
    "for k in K:\n",
    "    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)\n",
    "    kmeans.fit(rfm_scaled)\n",
    "    inertias.append(kmeans.inertia_)\n",
    "\n",
    "# Plot Elbow curve\n",
    "fig, ax = plt.subplots(figsize=(10, 5))\n",
    "ax.plot(K, inertias, 'bo-')\n",
    "ax.set_xlabel('Number of Clusters (k)')\n",
    "ax.set_ylabel('Inertia')\n",
    "ax.set_title('Elbow Method for Optimal k')\n",
    "plt.tight_layout()\n",
    "plt.savefig('elbow_curve.png', dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Apply K-means with k=4 (typical for customer segmentation)\n",
    "kmeans = KMeans(n_clusters=4, random_state=42, n_init=10)\n",
    "rfm['cluster'] = kmeans.fit_predict(rfm_scaled)\n",
    "\n",
    "# Cluster analysis\n",
    "cluster_summary = rfm.groupby('cluster').agg({\n",
    "    'recency': 'mean',\n",
    "    'frequency': 'mean',\n",
    "    'monetary': 'mean',\n",
    "    'customer_id': 'count'\n",
    "}).round(2)\n",
    "cluster_summary.columns = ['Avg Recency', 'Avg Frequency', 'Avg Monetary', 'Count']\n",
    "\n",
    "print(\"Cluster Summary:\")\n",
    "print(cluster_summary)\n",
    "\n",
    "# Visualize clusters\n",
    "fig, axes = plt.subplots(1, 3, figsize=(15, 4))\n",
    "\n",
    "for i, col in enumerate(['recency', 'frequency', 'monetary']):\n",
    "    rfm.groupby('cluster')[col].mean().plot(kind='bar', ax=axes[i], color='#3498db')\n",
    "    axes[i].set_title(f'Avg {col.capitalize()} by Cluster')\n",
    "    axes[i].set_xlabel('Cluster')\n",
    "    axes[i].set_ylabel(col.capitalize())\n",
    "    plt.sca(axes[i])\n",
    "    plt.xticks(rotation=0)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('cluster_analysis.png', dpi=150)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Key Insights & Recommendations"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"\"\"\n",
    "## 🔑 Key Findings\n",
    "\n",
    "### Segment Distribution:\n",
    f\"- Champions: {(rfm['segment']=='Champions').sum()} customers (high value)\n",
    f\"- At Risk: {(rfm['segment']=='At Risk').sum()} customers (need attention)\n",
    f\"- Lost: {(rfm['segment']=='Lost').sum()} customers (low engagement)\n",
    "\n",
    "### Cluster Insights:\n",
    f\"- Cluster 0: {cluster_summary.iloc[0]['Count']:.0f} customers - {'High value' if cluster_summary.iloc[0]['Avg Monetary'] > rfm['monetary'].mean() else 'Low value'}\n",
    f\"- Cluster 1: {cluster_summary.iloc[1]['Count']:.0f} customers - {'Frequent buyers' if cluster_summary.iloc[1]['Avg Frequency'] > rfm['frequency'].mean() else 'Occasional'}\n",
    "\n",
    "---\n",
    "\n",
    "## 💡 Recommendations\n",
    "\n",
    "### For Champions:\n",
    "- Offer VIP rewards and early access to new products\n",
    "- Create loyalty program with exclusive benefits\n",
    "\n",
    "### For At Risk:\n",
    "- Send personalized re-engagement campaigns\n",
    "- Offer discounts or special promotions\n",
    "\n",
    "### For Lost:\n",
    "- Win-back campaigns with strong incentives\n",
    "- Survey to understand why they left\n",
    "\n",
    "### General:\n",
    "- Focus marketing budget on Champions and Loyal Customers\n",
    "- Develop targeted campaigns for each segment\n",
    "\"\"\")"
   ]
  }
 ],
